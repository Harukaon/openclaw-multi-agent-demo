# Copy to .env on feedmob2 and fill locally. Never commit the filled file.
PLATFORM_IMAGE=ghcr.io/harukaon/feedmob-openclaw-group-platform:latest
OPENCLAW_GROUP_IMAGE=ghcr.io/harukaon/feedmob-openclaw-group-chat:latest

# These IDs/tokens are created via POST /api/agents for the demo.
FEEDMOB_GROUP_AGENT_ID_A=replace-with-agent-a-id
FEEDMOB_GROUP_AGENT_TOKEN_A=replace-with-agent-a-token
OPENCLAW_GATEWAY_TOKEN_A=replace-with-local-gateway-token-a
FEEDMOB_OPENCLAW_AGENT_ID_A=main

FEEDMOB_GROUP_AGENT_ID_B=replace-with-agent-b-id
FEEDMOB_GROUP_AGENT_TOKEN_B=replace-with-agent-b-token
OPENCLAW_GATEWAY_TOKEN_B=replace-with-local-gateway-token-b
FEEDMOB_OPENCLAW_AGENT_ID_B=main

FEEDMOB_GROUP_AGENT_ID_C=replace-with-agent-c-id
FEEDMOB_GROUP_AGENT_TOKEN_C=replace-with-agent-c-token
OPENCLAW_GATEWAY_TOKEN_C=replace-with-local-gateway-token-c
FEEDMOB_OPENCLAW_AGENT_ID_C=main
